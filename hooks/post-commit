#!/bin/sh
# Git post-commit hook: when the user commits outside an agent session, offer
# to launch an agent with a learning-opportunity prompt. Uses Claude Code
# (`claude`) if it is on PATH, otherwise opencode. Only fires if one of them
# is available and the daily offer cap (5) has not been reached.
#
# Commits made inside an agent session are handled there instead:
# .claude/scripts/post-tool-use.sh (Claude Code) and
# .claude/plugins/learning-opportunity.ts (opencode). This hook keeps its own
# per-day budget, separate from their per-session budgets.

# --- Only fire when run from a real terminal (not inside an agent) ---
[ -t 0 ] || exit 0

# --- Rate limiting (per calendar day) ---
STATE_FILE="${TMPDIR:-/tmp}/lo_auto_git-$(date +%Y-%m-%d).state"
offers=0
if [ -f "$STATE_FILE" ]; then
  offers=$(cat "$STATE_FILE" 2>/dev/null || echo 0)
fi

if [ "$offers" -ge 5 ]; then
  exit 0
fi

# --- Pick an agent CLI; bail if none is available ---
if command -v claude >/dev/null 2>&1; then
  AGENT=claude
elif command -v opencode >/dev/null 2>&1; then
  AGENT=opencode
else
  exit 0
fi

# --- Gather commit context ---
HASH=$(git log -1 --format=%h)
MSG=$(git log -1 --format=%s)
FILES=$(git diff --name-only HEAD~1 HEAD 2>/dev/null | head -20)

# --- Ask before launching ---
printf '\n\033[1;36m📚 Learning opportunity available\033[0m — launch %s? [Y/n] ' "$AGENT"
read -r answer
if [ "$answer" = "n" ] || [ "$answer" = "N" ]; then
  exit 0
fi

# --- Record the offer (rate limiting) ---
echo $(( offers + 1 )) > "$STATE_FILE"

# --- Launch the agent ---
PROMPT="[learning-opportunities-auto] The user just committed code outside of an agent session.

Commit: $HASH
Message: $MSG
Files changed:
$FILES

Per the learning-opportunities skill, consider whether this is a good moment to offer a learning exercise. If the committed work involved new files, schema changes, architectural decisions, refactors, or unfamiliar patterns, ask the user (one short sentence) if they'd like a 10-15 minute exercise. Do not start the exercise until they confirm. If they decline, note it — no more offers this session."

if [ "$AGENT" = claude ]; then
  # Interactive session seeded with the prompt, so the student can reply.
  claude "$PROMPT"
else
  opencode run "$PROMPT"
fi

exit 0
